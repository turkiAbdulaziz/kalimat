{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/forms/**",
              "components/game/**",
              "ui_kits/kalimat_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Kufi Arabic|IBM Plex Sans Arabic|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Noto Kufi Arabic, IBM Plex Sans Arabic, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|tone|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|soft)$/]",
        "message": "<Avatar> tone must be one of 'accent' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|solid)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|inverse)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:length|value|onChange|size|key|ref|className|style|children)$/]",
        "message": "<CodeInput> doesn't accept that prop. Declared props: length, value, onChange, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|onClose|footer|children|width|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, onClose, footer, children, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='DistributionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:guess|count|max|highlight|key|ref|className|style|children)$/]",
        "message": "<DistributionBar> doesn't accept that prop. Declared props: guess, count, max, highlight."
      },
      {
        "selector": "JSXOpeningElement[name.name='GuessCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:letter|state|key|ref|className|style|children)$/]",
        "message": "<GuessCell> doesn't accept that prop. Declared props: letter, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='GuessCell'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:empty|filled|correct|present|absent)$/]",
        "message": "<GuessCell> state must be one of 'empty' | 'filled' | 'correct' | 'present' | 'absent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|value|onChange|invalid|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, value, onChange, invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='Keyboard'] > JSXAttribute > JSXIdentifier[name!=/^(?:letterStates|onKey|onEnter|onDelete|disabled|key|ref|className|style|children)$/]",
        "message": "<Keyboard> doesn't accept that prop. Declared props: letterStates, onKey, onEnter, onDelete, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyCap'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|state|wide|disabled|onPress|children|key|ref|className|style|children)$/]",
        "message": "<KeyCap> doesn't accept that prop. Declared props: label, state, wide, disabled, onPress, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyCap'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|correct|present|absent)$/]",
        "message": "<KeyCap> state must be one of 'idle' | 'correct' | 'present' | 'absent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|value|onClick|danger|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: icon, label, value, onClick, danger."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|emphasis|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: value, label, emphasis."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|hint|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tile'] > JSXAttribute > JSXIdentifier[name!=/^(?:letter|state|size|animate|revealDelay|key|ref|className|style|children)$/]",
        "message": "<Tile> doesn't accept that prop. Declared props: letter, state, size, animate, revealDelay."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tile'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:empty|filled|correct|present|absent)$/]",
        "message": "<Tile> state must be one of 'empty' | 'filled' | 'correct' | 'present' | 'absent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|tone|visible|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: message, tone, visible."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success)$/]",
        "message": "<Toast> tone must be one of 'neutral' | 'success'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
